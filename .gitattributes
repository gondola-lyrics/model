# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Node files
*.js text eol=lf
*.ts text eol=lf

# Proto files
*.proto text eol=lf

# Python files
*.py text eol=lf

# Config files
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts
*.ps1 text eol=lf
*.sh text eol=lf
