{
  "name": "@gondola-lyrics/model",
  "version": "0.0.0",
  "description": "Gondola lyrics data model",
  "keywords": [
    "lyrics",
    "lyric",
    "karaoke",
    "protobuf",
    "schema",
    "gondola"
  ],
  "license": "MIT",
  "author": "folltoshe",
  "homepage": "https://github.com/gondola-lyrics/model#readme",
  "bugs": {
    "url": "https://github.com/gondola-lyrics/model/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gondola-lyrics/model.git",
    "directory": "node"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "npm run generate:proto && npm run generate:version",
    "generate:proto": "buf generate",
    "generate:version": "tsx script/version.ts",
    "build": "vite build",
    "release": "tsx script/publish.ts",
    "format": "prettier --write ."
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.14.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.14.1",
    "@bufbuild/protoc-gen-es": "2.14.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0"
  }
}
