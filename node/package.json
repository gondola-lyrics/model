{
  "name": "@gondola-lyrics/model",
  "version": "0.0.0",
  "description": "Gondola lyrics data model",
  "keywords": [
    "lyrics",
    "lyric",
    "karaoke",
    "protobuf",
    "schema",
    "gondola"
  ],
  "license": "MIT",
  "author": "folltoshe",
  "homepage": "https://github.com/gondola-lyrics/model#readme",
  "bugs": {
    "url": "https://github.com/gondola-lyrics/model/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gondola-lyrics/model.git",
    "directory": "node"
  },
  "type": "module",
  "scripts": {
    "generate": "npm run generate:proto && npm run generate:version",
    "generate:proto": "buf generate",
    "generate:version": "tsx script/version.ts",
    "build": "vite build",
    "format": "prettier --write ."
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0"
  }
}
